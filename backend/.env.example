PORT=3001
SUPABASE_URL=https://scyreebjlbhaeovpskqs.supabase.co
SUPABASE_PROJECT_REF=scyreebjlbhaeovpskqs
# Prefira a secret key nova (sb_secret_...) a projetos que ainda tem a legada (JWT
# eyJ...) habilitada: a legada some quando o projeto desativa "legacy API keys".
# NUNCA commite o valor real.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
SUPABASE_ANON_KEY=sua-anon-key-aqui
# Token de management (sbp_...) — usado p/ DDL/queries via Supabase Management API (curl)
SUPABASE_ACCESS_TOKEN=sbp_seu-token-de-management-aqui
# Opcional — alerta de erro via Telegram (reportError, ver CLAUDE.md). Sem isso,
# reportError so grava em error_logs, sem alertar ninguem. Skill /novo-projeto
# guia a criacao do bot.
TELEGRAM_SUPPORT_BOT_TOKEN=
TELEGRAM_SUPPORT_CHAT_ID=

# --- Integrações futuras (opcionais). O app sobe sem nenhuma delas. ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_MODEL_FAST=gpt-4.1-mini
OPENAI_MONTHLY_BUDGET_USD=50

# Chrome CDP / Instagram — NÃO implementados neste slice. Deixe vazio.
CHROME_CDP_URL=
CHROME_PROFILE_DIR=
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

MAX_DMS_PER_DAY=30
MIN_SECONDS_BETWEEN_DMS=90
MAX_SECONDS_BETWEEN_DMS=240
OPERATING_HOURS=09:00-20:00
OPERATING_TIMEZONE=America/Sao_Paulo

# Worker em processo (tabela jobs no Postgres, sem Redis). false = só HTTP.
WORKER_ENABLED=true
WORKER_POLL_MS=2000
